# Copy to .env. Demo mode needs no key and never contacts an AI provider.
CURISTRO_MODE=demo
OPENAI_API_KEY=

# To use your own provider, set CURISTRO_MODE=live and configure these locally.
OPENAI_BASE_URL=https://api.openai.com/v1
CURISTRO_CHAT_MODEL=o4-mini
CURISTRO_QUIZ_MODEL=o4-mini
CURISTRO_OUTPUT_MODE=json_schema
CURISTRO_TOKEN_PARAMETER=max_completion_tokens
CURISTRO_MAX_OUTPUT_TOKENS=4096
CURISTRO_STT_MODEL=whisper-1
CURISTRO_TTS_MODEL=tts-1
CURISTRO_TTS_VOICE=alloy

# Optional font supporting your session's characters, e.g. CJK. Relative paths
# are resolved against this repository. The bundled font is DejaVu Sans.
CURISTRO_PDF_FONT=
CURISTRO_PORT=5058
# Optional stable cookie-signing secret. Blank generates one at startup.
CURISTRO_SECRET_KEY=
